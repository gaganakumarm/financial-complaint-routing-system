FCRS_APP_NAME=Financial Complaint Routing System API
FCRS_APP_ENV=development
FCRS_DEBUG=false
FCRS_API_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_complaints
JWT_SECRET_KEY=development-only-change-me-please-replace
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated explicit origins; production must use its deployed frontend origin.
# The wildcard "*" is intentionally unsupported.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
